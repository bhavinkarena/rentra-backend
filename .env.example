# Validated at boot — the process refuses to start on an invalid value rather
# than 500ing on the first request. Shared keys live in
# src/services/schemas/joi/env.js (ported from the frontend, kept identical);
# the server-only keys below are in src/config/env.js.

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Browser origins allowed to call this API with cookies. Comma separated.
# There is no wildcard: `Access-Control-Allow-Origin: *` is incompatible with
# credentialed requests, so a wildcard would break auth, not loosen it.
CORS_ORIGINS=http://localhost:3000

# How many reverse proxies sit in front of this process. Set it to the real hop
# count — `true`/high values let a caller spoof their own IP past the limiter.
TRUST_PROXY_HOPS=0

# Cross-site cookies need SameSite=None, which browsers only accept with Secure.
# Leave `lax` when the frontend and API share a parent domain (recommended).
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

REQUEST_BODY_LIMIT=1mb
LOG_FORMAT=dev

# ── Shared with the frontend ─────────────────────────────────────────────────
# The public site origin. Used for the measurement beacon origin check and for
# absolute links in notifications.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rentra
REDIS_URL=redis://localhost:6379

# Signs the session JWT and peppers the OTP hash. 32 chars minimum.
# Generate with: openssl rand -base64 32
# Rotating it invalidates every session and every outstanding OTP.
# MUST be byte-identical to the frontend's value while both issue sessions.
SESSION_SECRET=

# TOTAL AUTHENTICATION BYPASS — accepts 123456 as any OTP. Boot fails if this
# is true with NODE_ENV=production.
DEV_OTP_BYPASS=false

# Unset defaults to development-only in NODE_ENV=development/test: click Send
# code, then use 123456 (no SMS). Never set `development` on a deployed app.
CUSTOMER_OTP_DELIVERY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Single-IP header overwritten by your trusted ingress (e.g. x-real-ip).
# Leave blank locally. Missing/invalid IPs share one conservative rate bucket.
CUSTOMER_AUTH_IP_HEADER=

# ── Razorpay (TEST only) ─────────────────────────────────────────────────────
# The key ID must begin with rzp_test_. Configure a separate webhook secret in
# Razorpay's TEST dashboard and point it at POST /webhooks/razorpay.
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_TEST_WEBHOOK_SECRET=
# Retain old TEST keys for existing attempts: {"rzp_test_OLD":{"keySecret":"..."}}
RAZORPAY_TEST_KEYRING_JSON={}
# Retain older TEST webhook secrets during provider retries, up to 10 entries.
RAZORPAY_TEST_PREVIOUS_WEBHOOK_SECRETS=[]

# ── Cloudinary — KYC storage (authenticated type, signed delivery only) ──────
# All three are needed together; a half-configured uploader fails mid-onboarding.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Notifications ────────────────────────────────────────────────────────────
# Durable booking notifications stay in-app when SMS is disabled/unconfigured.
CUSTOMER_NOTIFICATION_DELIVERY=disabled
# Additional explicit opt-in before any Test/simulation booking can send SMS.
CUSTOMER_NOTIFICATION_ALLOW_TEST_SMS=false

WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=
NEXT_PUBLIC_WHATSAPP_NUMBER=
RENTRA_SUPPORT_EMAIL=
RENTRA_SUPPORT_HOURS=

# ── Measurement ──────────────────────────────────────────────────────────────
# Aggregate-only funnel counters. No identifiers, query strings, form input or
# payment tokens. Browser events respect DNT/GPC; aggregates retained 90 days.
RENTRA_MEASUREMENT_ENABLED=false
